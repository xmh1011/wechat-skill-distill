# Runtime recall used by chat-ui.
# auto infers the first configured backend in this order:
# Hindsight, generic-http, Mem0, JSONL.
# Values: auto | hindsight | generic-http | mem0 | jsonl | off
WSD_MEMORY_RECALL_BACKEND=auto
WSD_MEMORY_RECALL_MODE=auto
WSD_MEMORY_RESULT_LIMIT=24
WSD_MEMORY_MAX_TOKENS=3200
WSD_RECALL_QUERY_PLANNER=auto
WSD_MEMORY_QUERY_VARIANTS=1

HINDSIGHT_API_URL=
HINDSIGHT_BANK_ID=default-bank
HINDSIGHT_API_KEY=
WSD_HINDSIGHT_TAGS=
WSD_HINDSIGHT_TAGS_MATCH=all_strict
WSD_HINDSIGHT_TYPES=world,observation
WSD_HINDSIGHT_MAX_TOKENS=3200

MEM0_API_KEY=

MEMORY_WRITE_URL=
MEMORY_RECALL_URL=
MEMORY_API_KEY=

JSONL_MEMORY_PATH=

# Chat UI model runtime. API keys stay on the local server side.
# WSD_MODEL_PROVIDER=openai | anthropic | gemini
WSD_MODEL_PROVIDER=openai
WSD_MODEL_MAX_TOKENS=800
WSD_ALLOW_CLIENT_PROVIDER_OVERRIDE=0
WSD_ALLOW_CLIENT_MODEL_OVERRIDE=0
WSD_DEBUG_ERRORS=0

# OpenAI-compatible providers, including OpenAI, OneAPI, DeepSeek-compatible gateways, etc.
WSD_OPENAI_BASE_URL=https://api.openai.com/v1
WSD_OPENAI_MODEL=
WSD_OPENAI_API_KEY=

# Anthropic Messages API.
WSD_ANTHROPIC_BASE_URL=https://api.anthropic.com
WSD_ANTHROPIC_MODEL=
WSD_ANTHROPIC_API_KEY=

# Gemini generateContent API.
WSD_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
WSD_GEMINI_MODEL=
WSD_GEMINI_API_KEY=

# Cloud deployment / static frontend integration.
# Set this when the browser is served from a different domain, for example Tiiny Host.
# Use the exact frontend origin in production, such as https://your-site.tiiny.site.
WSD_CORS_ORIGINS=

# Optional but recommended for public deployments.
# Frontend URL can pass it as ?accessToken=...
WSD_CHAT_AUTH_TOKEN=

# Optional: preload cloud skills without committing private skill files.
# macOS: base64 -i generated-chat-skills/朋友.chat-memory.skill | tr -d '\n'
WSD_SKILL_1_TEXT_BASE64=
WSD_SKILL_1_FILE_NAME=朋友.chat-memory.skill
WSD_SKILL_1_DISPLAY_NAME=朋友
